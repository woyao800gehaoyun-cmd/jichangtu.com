{% from "macros/icon.njk" import icon %}
{% from "macros/cards.njk" import articleCard %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}｜{{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <link rel="icon" type="image/svg+xml" href="{{ page.url | relativeAsset('favicon.svg') }}">
  <link rel="stylesheet" href="{{ page.url | relativeAsset('assets/css/main.css') }}">
  <meta property="og:type" content="article"><meta property="og:site_name" content="{{ site.name }}"><meta property="og:locale" content="zh_CN"><meta property="og:title" content="{{ title }}｜{{ site.name }}"><meta property="og:description" content="{{ description }}"><meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}"><meta property="og:image" content="{{ '/og-default.svg' | absoluteUrl(site.url) }}">
  <meta property="article:published_time" content="{{ page.date | isoDate }}">{% if updatedAt %}<meta property="article:modified_time" content="{{ updatedAt | isoDate }}">{% endif %}
  <script type="application/ld+json">{{ { '@context': 'https://schema.org', '@type': 'Article', headline: title, description: description, datePublished: (page.date | isoDate), dateModified: ((updatedAt or page.date) | isoDate), inLanguage: 'zh-CN', author: { '@type': 'Organization', name: site.author }, publisher: { '@type': 'Organization', name: site.name }, mainEntityOfPage: (page.url | absoluteUrl(site.url)) } | json | safe }}</script>
</head>
<body>
  <a href="#main-content" class="fixed left-4 top-3 z-[100] -translate-y-20 rounded-lg bg-ink-950 px-4 py-2 text-sm text-white transition focus:translate-y-0">跳到主要内容</a>
  {% include "partials/header.njk" %}
  <main id="main-content">
    <div class="border-b border-line bg-paper/70"><nav class="container-shell flex items-center gap-2 py-5 text-xs text-ink-500" aria-label="面包屑"><a href="/">首页</a><span>›</span><a href="/blog/">文章</a><span>›</span><span class="truncate text-ink-700">{{ title }}</span></nav></div>
    <header class="container-shell py-14 sm:py-20"><div class="mx-auto max-w-4xl text-center"><a href="/blog/?category={{ category | urlEncode }}" class="inline-flex rounded-full bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-600">{{ category }}</a><h1 class="mt-6 text-[clamp(2.2rem,5vw,4.3rem)] font-black leading-[1.12] tracking-[-0.055em] text-ink-950">{{ title }}</h1><p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-ink-500">{{ description }}</p><div class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-ink-500"><span class="flex items-center gap-1.5">{{ icon('calendar', 14) }}发布于 {{ page.date | dateZh }}</span>{% if updatedAt %}<span class="flex items-center gap-1.5">{{ icon('clock', 14) }}更新于 {{ updatedAt | dateZh }}</span>{% endif %}<span>{{ readingTime }}</span><span>{{ site.author }}</span></div><div class="mt-6 flex flex-wrap justify-center gap-2">{% for tag in tags %}<span class="rounded-md bg-paper px-2 py-1 text-xs text-ink-500">#{{ tag }}</span>{% endfor %}</div></div></header>
    <div class="container-shell pb-20 lg:pb-28"><div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-start"><article class="min-w-0"><div class="mb-8 rounded-2xl border border-brand-100 bg-brand-50/70 p-5 text-sm leading-7 text-ink-700"><strong class="text-ink-950">内容说明：</strong> {{ contentNotice or '本文提供信息整理与选择框架，不构成对速度、稳定性、解锁能力或持续可用性的承诺。服务规则可能变化，请以最近核验结果和服务方页面为准。' }}</div><div class="article-prose">{{ content | safe }}</div></article><aside class="hidden lg:sticky lg:top-24 lg:block"><div class="rounded-2xl bg-ink-950 p-5 text-white">{{ icon('layers', 19, 'text-cyan-400') }}<p class="mt-4 text-sm font-semibold">继续浏览相关内容</p><p class="mt-2 text-xs leading-5 text-slate-400">从专题页查看同一主题下的教程、评测与问题解答。</p><a href="/topics/" class="mt-4 inline-flex items-center gap-2 text-xs font-semibold text-cyan-400">查看专题 {{ icon('arrow', 14) }}</a></div></aside></div></div>
    {% set related = collections.posts | rejectUrl(page.url) | limit(3) %}
    <section class="border-t border-line bg-paper py-16 lg:py-20"><div class="container-shell"><div class="mb-8 flex items-end justify-between gap-5"><div><span class="eyebrow">Related</span><h2 class="mt-3 text-2xl font-bold tracking-tight text-ink-950">继续阅读</h2></div><a href="/blog/" class="text-sm font-semibold text-brand-600">全部文章 →</a></div><div class="grid gap-6 md:grid-cols-3">{% for post in related %}{{ articleCard(post, loop.index) }}{% endfor %}</div></div></section>
  </main>
  {% include "partials/footer.njk" %}
  <script src="{{ page.url | relativeAsset('assets/js/site.js') }}" defer></script>
</body>
</html>
