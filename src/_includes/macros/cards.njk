{% from "macros/icon.njk" import icon %}

{% macro articleCard(post, index=0) %}
{% set covers = ['/images/cover-compass.svg', '/images/cover-devices.svg', '/images/cover-network.svg', '/images/cover-shield.svg'] %}
<article class="group surface-card flex h-full flex-col overflow-hidden transition duration-300 hover:-translate-y-1.5 hover:border-brand-100 hover:shadow-soft">
  <a href="{{ post.url }}" class="focus-ring relative block aspect-[16/9] overflow-hidden bg-[#efe8dc]" aria-label="阅读：{{ post.data.title }}">
    <img src="{{ covers[index % 4] }}" alt="" width="800" height="450" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.035]">
    <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[#292524]/12 to-transparent"></div>
    <span class="absolute left-5 top-5 rounded-full border border-white/80 bg-white/82 px-3 py-1 text-xs font-semibold text-ink-700 shadow-sm backdrop-blur">{{ post.data.category }}</span>
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-500"><span class="flex items-center gap-1.5">{{ icon('calendar', 14) }}{{ post.date | dateZh }}</span><span>·</span><span class="flex items-center gap-1.5">{{ icon('clock', 14) }}{{ post.data.readingTime }}</span>{% if post.data.updatedAt %}<span class="rounded-md bg-paper px-2 py-1">更新 {{ post.data.updatedAt | dateZh }}</span>{% endif %}</div>
    <h3 class="mt-4 text-xl font-bold leading-snug tracking-[-0.025em] text-ink-950 transition group-hover:text-brand-600"><a href="{{ post.url }}" class="focus-ring rounded">{{ post.data.title }}</a></h3>
    <p class="mt-3 line-clamp-3 text-sm leading-7 text-ink-500">{{ post.data.description }}</p>
    <div class="mt-5 flex flex-wrap gap-2">{% for tag in post.data.tags | limit(3) %}<span class="rounded-md bg-paper px-2 py-1 text-[0.7rem] text-ink-500">#{{ tag }}</span>{% endfor %}</div>
    <a href="{{ post.url }}" class="focus-ring mt-6 inline-flex items-center gap-2 self-start rounded text-sm font-semibold text-brand-600 transition group-hover:gap-3">阅读全文{{ icon('arrow', 16) }}</a>
  </div>
</article>
{% endmacro %}

{% macro faq(items) %}
<div class="mx-auto max-w-3xl divide-y divide-line border-y border-line">
  {% for item in items %}<details class="group py-1" {% if loop.first %}open{% endif %}><summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-6 rounded-xl py-5 text-left text-base font-semibold text-ink-950 marker:hidden"><span>{{ item.question }}</span><span class="grid size-8 shrink-0 place-items-center rounded-full bg-paper text-ink-500 transition group-open:rotate-45 group-open:bg-brand-50 group-open:text-brand-600"><span class="text-xl font-light leading-none">+</span></span></summary><div class="pb-6 pr-12 text-sm leading-7 text-ink-500">{{ item.answer }}</div></details>{% endfor %}
</div>
{% endmacro %}
