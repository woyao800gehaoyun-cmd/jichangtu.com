---
layout: layouts/base.njk
pagination:
  data: sections
  size: 1
  alias: section
permalink: "/{{ section.slug }}/index.html"
eleventyComputed:
  title: "{{ section.title }}"
  description: "{{ section.description }}"
---
{% from "macros/icon.njk" import icon %}
{% from "macros/cards.njk" import faq %}
<div class="border-b border-line bg-[#faf8f3]"><nav class="container-shell flex items-center gap-2 py-5 text-xs text-ink-500" aria-label="面包屑"><a href="/">首页</a><span>›</span><span class="text-ink-700">{{ section.title }}</span></nav></div>

<section class="paper-texture relative overflow-hidden border-b border-line">
  <div class="absolute -right-24 top-8 size-80 rounded-full bg-[#fed7aa]/45 blur-3xl"></div>
  <div class="absolute left-[44%] top-24 size-52 rounded-full bg-[#d1fae5]/50 blur-3xl"></div>
  <div class="container-shell relative grid gap-12 py-16 lg:grid-cols-[1fr_.55fr] lg:items-center lg:py-24">
    <div class="max-w-3xl">
      <span class="eyebrow">{{ section.eyebrow }}</span>
      <h1 class="mt-5 text-[clamp(2.7rem,6vw,5rem)] font-bold leading-[1.08] tracking-[-0.05em] text-ink-950">{{ section.title }}</h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-ink-500 sm:text-lg">{{ section.description }}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {% if section.providers %}<a href="#recommendations" class="focus-ring inline-flex items-center gap-2 rounded-xl bg-ink-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-600">查看机场推荐 {{ icon('arrow', 16) }}</a>{% else %}<a href="#directory" class="focus-ring inline-flex items-center gap-2 rounded-xl bg-ink-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-600">查看内容入口 {{ icon('arrow', 16) }}</a>{% endif %}
        <a href="/blog/" class="focus-ring inline-flex items-center gap-2 rounded-xl border border-line bg-white px-5 py-3 text-sm font-semibold text-ink-700 shadow-card">浏览全部文章</a>
      </div>
    </div>
    <div class="mx-auto w-full max-w-sm rounded-[2.25rem] border border-white bg-white/88 p-7 shadow-soft backdrop-blur lg:ml-auto">
      <div class="grid size-16 place-items-center rounded-2xl bg-brand-50 text-brand-600">{{ icon(section.icon, 30, '', '1.5') }}</div>
      <h2 class="mt-7 text-2xl font-bold text-ink-950">栏目阅读原则</h2>
      <div class="mt-5 grid gap-3">{% for item in section.highlights %}<div class="flex items-center gap-3 rounded-xl border border-line bg-[#faf8f3] px-4 py-3 text-sm font-semibold text-ink-700">{{ icon('check', 16, 'text-forest-600') }}{{ item }}</div>{% endfor %}</div>
    </div>
  </div>
</section>

{% if section.providers %}
<section id="recommendations" class="section-space scroll-mt-24 bg-[#faf8f3]"><div class="container-shell">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><div class="max-w-2xl"><span class="eyebrow">Featured Services</span><h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-ink-950">已收录的机场入口</h2><p class="mt-4 text-sm leading-7 text-ink-500">以下入口包含推广参数。本站提供信息入口和选择指南，不承诺第三方服务的价格、速度、稳定性或持续可用性。</p></div><span class="inline-flex self-start rounded-full border border-brand-100 bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-700">共收录 {{ section.providers | length }} 个服务</span></div>
  <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{% for provider in section.providers %}<article class="group relative overflow-hidden rounded-3xl border border-line bg-white p-6 shadow-card transition duration-300 hover:-translate-y-1 hover:border-brand-100 hover:shadow-soft"><div class="absolute -right-12 -top-12 size-32 rounded-full bg-brand-50 transition duration-500 group-hover:scale-125"></div><div class="relative flex items-start justify-between gap-4"><span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-[#78350f] to-brand-500 text-xl font-black text-white shadow-card">{{ provider.mark }}</span><span class="rounded-full border border-brand-100 bg-brand-50 px-2.5 py-1 text-[0.68rem] font-semibold text-brand-700">{{ provider.label }}</span></div><div class="relative mt-7"><h3 class="text-xl font-bold tracking-tight text-ink-950">{{ provider.name }}</h3><p class="mt-3 min-h-20 text-sm leading-7 text-ink-500">{{ provider.description }}</p><a href="{{ provider.url }}" target="_blank" rel="sponsored nofollow noopener noreferrer" referrerpolicy="no-referrer" class="focus-ring mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-ink-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-600" aria-label="访问 {{ provider.name }} 外部服务页面">访问服务页面 {{ icon('arrow-up-right', 16) }}</a><p class="mt-3 text-center text-[0.68rem] leading-5 text-ink-400">将在新窗口打开第三方网站</p></div></article>{% endfor %}</div>
</div></section>
{% endif %}

{% if section.keywordGroups %}
<section class="border-y border-line bg-paper py-16 lg:py-20"><div class="container-shell"><div class="max-w-3xl"><span class="eyebrow">Keyword Map</span><h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-ink-950">机场主题知识地图</h2><p class="mt-4 text-sm leading-7 text-ink-500">将相近搜索问题按意图合并，每组关键词连接一篇完整指南，减少重复内容与关键词堆砌。</p></div><div class="mt-10 grid gap-5 lg:grid-cols-2">{% for group in section.keywordGroups %}<article class="rounded-3xl border border-line bg-white p-6 shadow-card"><div class="flex items-start justify-between gap-4"><div><h3 class="text-lg font-bold text-ink-950">{{ group.title }}</h3><p class="mt-2 text-sm leading-6 text-ink-500">{{ group.description }}</p></div><a href="{{ group.url }}" class="focus-ring shrink-0 rounded-lg bg-brand-50 px-3 py-2 text-xs font-semibold text-brand-700">阅读指南</a></div><div class="mt-5 flex flex-wrap gap-2">{% for keyword in group.keywords %}<span class="rounded-full border border-line bg-[#faf8f3] px-3 py-1.5 text-xs text-ink-600">{{ keyword }}</span>{% endfor %}</div></article>{% endfor %}</div></div></section>
{% endif %}

<section id="directory" class="section-space bg-[#faf8f3]"><div class="container-shell"><div class="max-w-2xl"><span class="eyebrow">Directory</span><h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-ink-950">从这里继续阅读</h2><p class="mt-4 text-sm leading-7 text-ink-500">每个入口都对应一项具体任务或问题，可直接进入完整文章、专题或站内说明。</p></div><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{% for entry in section.entries %}<a href="{{ entry.url }}" class="focus-ring group flex min-h-56 flex-col rounded-3xl border border-line bg-white p-6 shadow-card transition hover:-translate-y-1 hover:border-brand-100 hover:shadow-soft"><div class="flex items-center justify-between"><span class="text-xs font-bold text-brand-600">0{{ loop.index }}</span>{{ icon('arrow-up-right', 16, 'text-ink-300 transition group-hover:text-brand-600') }}</div><h3 class="mt-8 text-lg font-bold text-ink-950">{{ entry.title }}</h3><p class="mt-3 flex-1 text-sm leading-7 text-ink-500">{{ entry.description }}</p><span class="mt-5 text-xs font-semibold text-forest-600">查看详细内容</span></a>{% endfor %}</div></div></section>

<section class="border-y border-line bg-paper py-16 lg:py-20"><div class="container-shell grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><span class="eyebrow">Overview</span><h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-950">关于本栏目</h2></div><div><p class="text-base leading-8 text-ink-700">{{ section.intro }}</p><div class="mt-8 grid gap-3 sm:grid-cols-3">{% for item in section.highlights %}<div class="flex items-center gap-2 rounded-xl border border-line bg-white px-4 py-3 text-xs font-semibold text-ink-700 shadow-card">{{ icon('check', 15, 'text-forest-600') }}{{ item }}</div>{% endfor %}</div></div></div></section>

<section class="section-space bg-[#faf8f3]"><div class="container-shell"><div class="mx-auto mb-10 max-w-2xl text-center"><span class="eyebrow">FAQ</span><h2 class="mt-3 text-3xl font-bold text-ink-950">常见问题</h2><p class="mt-4 text-sm leading-7 text-ink-500">先说明边界和判断方法，再进入更具体的文章与操作步骤。</p></div>{{ faq(section.faqs) }}</div></section>

<section class="container-shell pb-20 lg:pb-28"><div class="relative overflow-hidden rounded-[2rem] border border-[#3f4d46] bg-[#273c34] px-6 py-14 text-white shadow-soft sm:px-10 lg:px-16"><div class="absolute -right-20 -top-24 size-72 rounded-full bg-brand-500/20 blur-3xl"></div><div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><h2 class="text-3xl font-bold">有问题、勘误或合作建议？</h2><p class="mt-4 text-sm leading-7 text-[#d6ddd8]">通过 Telegram 联系我们，提交页面地址和具体问题，便于快速核验与更新。</p></div><div class="flex flex-wrap gap-3"><a href="/contact/" class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-ink-950">联系我们 {{ icon('arrow', 16) }}</a><a href="/blog/" class="inline-flex items-center gap-2 rounded-xl border border-white/20 px-5 py-3 text-sm font-semibold">浏览文章</a></div></div></div></section>
