---
layout: layouts/base.njk
pagination:
  data: sections
  size: 1
  alias: section
permalink: "/{{ section.slug }}/index.html"
eleventyComputed:
  title: "{{ section.title }}"
  description: "{{ section.description }}"
---
{% from "macros/icon.njk" import icon %}
{% from "macros/cards.njk" import faq %}
{% if section.providers %}
  {% set sectionFaqs = [
    { question: '推荐入口是否包含推广链接？', answer: '是。标有“推广链接”的按钮可能包含本站推广参数；请以服务方页面展示的套餐、价格和规则为准。' },
    { question: '推荐顺序代表服务排名吗？', answer: '不代表。当前卡片用于集中展示服务入口，不构成绝对排名或可用性承诺。' },
    { question: '访问外部页面前需要注意什么？', answer: '建议先核对域名、套餐条款、退款规则和最近更新信息，不要在不可信页面提交敏感资料。' }
  ] %}
{% else %}
  {% set sectionFaqs = [
    { question: section.title + '栏目现在可以直接使用吗？', answer: '页面结构和内链入口已经可用，但当前卡片与文字主要用于占位，正式发布前仍需补充经过核验的原创内容。' },
    { question: '后续如何增加新的内容？', answer: '文章可直接添加 Markdown 文件；资料卡片和专题数据可集中维护，无需重做页面布局。' },
    { question: '页面中的外部入口是否为真实链接？', answer: '不是。当前站点不包含真实推广跳转，未来加入外部链接时会清晰标注目标与必要声明。' }
  ] %}
{% endif %}
<div class="border-b border-line bg-paper/70"><nav class="container-shell flex items-center gap-2 py-5 text-xs text-ink-500"><a href="/">首页</a><span>›</span><span class="text-ink-700">{{ section.title }}</span></nav></div>
<section class="relative overflow-hidden border-b border-line bg-[linear-gradient(180deg,#f7f9ff,#fff)]"><div class="absolute right-[8%] top-8 size-72 rounded-full bg-brand-100/60 blur-3xl"></div><div class="container-shell relative grid gap-10 py-16 lg:grid-cols-[1fr_.55fr] lg:items-center lg:py-24"><div class="max-w-3xl"><span class="eyebrow">{{ section.eyebrow }}</span><h1 class="mt-5 text-[clamp(2.7rem,6vw,5rem)] font-black tracking-[-0.06em] text-ink-950">{{ section.title }}</h1><p class="mt-6 max-w-2xl text-base leading-8 text-ink-500 sm:text-lg">{{ section.description }}</p><div class="mt-8 flex flex-wrap gap-3">{% if section.providers %}<a href="#recommendations" class="focus-ring inline-flex items-center gap-2 rounded-xl bg-ink-950 px-5 py-3 text-sm font-semibold text-white">查看机场推荐 {{ icon('arrow', 16) }}</a>{% else %}<a href="#directory" class="focus-ring inline-flex items-center gap-2 rounded-xl bg-ink-950 px-5 py-3 text-sm font-semibold text-white">查看内容入口 {{ icon('arrow', 16) }}</a>{% endif %}<a href="/blog/" class="focus-ring inline-flex items-center gap-2 rounded-xl border border-line bg-white px-5 py-3 text-sm font-semibold text-ink-700">浏览全部文章</a></div></div><div class="mx-auto grid size-52 place-items-center rounded-[3rem] border border-white bg-white/70 text-brand-600 shadow-soft backdrop-blur lg:ml-auto lg:size-64"><div class="grid size-24 place-items-center rounded-[2rem] bg-brand-50">{{ icon(section.icon, 45, '', '1.4') }}</div></div></div></section>
{% if section.providers %}
<section id="recommendations" class="section-space scroll-mt-24 bg-white"><div class="container-shell"><div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><div class="max-w-2xl"><span class="eyebrow">Featured Services</span><h2 class="mt-3 text-3xl font-bold tracking-[-0.035em] text-ink-950">机场推荐</h2><p class="mt-4 text-sm leading-7 text-ink-500">以下入口包含推广链接。本站不承诺服务的价格、速度、稳定性或持续可用性，请在购买前自行核验。</p></div><span class="inline-flex self-start rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700">共收录 {{ section.providers | length }} 个服务</span></div><div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{% for provider in section.providers %}<article class="group relative overflow-hidden rounded-3xl border border-line bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand-100 hover:shadow-card"><div class="absolute -right-12 -top-12 size-32 rounded-full bg-brand-50 transition duration-500 group-hover:scale-125"></div><div class="relative flex items-start justify-between gap-4"><span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-ink-950 to-brand-600 text-xl font-black text-white shadow-lg shadow-indigo-950/15">{{ provider.mark }}</span><span class="rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[0.68rem] font-semibold text-amber-700">{{ provider.label }}</span></div><div class="relative mt-7"><h3 class="text-xl font-bold tracking-tight text-ink-950">{{ provider.name }}</h3><p class="mt-3 min-h-20 text-sm leading-7 text-ink-500">{{ provider.description }}</p><a href="{{ provider.url }}" target="_blank" rel="sponsored nofollow noopener noreferrer" referrerpolicy="no-referrer" class="focus-ring mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-ink-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-600" aria-label="访问 {{ provider.name }} 外部服务页面">访问服务页面 {{ icon('arrow-up-right', 16) }}</a><p class="mt-3 text-center text-[0.68rem] leading-5 text-ink-400">将在新窗口打开第三方网站</p></div></article>{% endfor %}</div></div></section>
{% endif %}
{% if section.keywordGroups %}
<section class="border-y border-line bg-paper py-16 lg:py-20"><div class="container-shell"><div class="max-w-3xl"><span class="eyebrow">Keyword Map</span><h2 class="mt-3 text-3xl font-bold tracking-[-0.035em] text-ink-950">机场主题知识地图</h2><p class="mt-4 text-sm leading-7 text-ink-500">将相近问题按搜索意图整合，避免重复堆词。每组关键词对应一篇结构完整的主题指南。</p></div><div class="mt-10 grid gap-5 lg:grid-cols-2">{% for group in section.keywordGroups %}<article class="rounded-3xl border border-line bg-white p-6"><div class="flex items-start justify-between gap-4"><div><h3 class="text-lg font-bold text-ink-950">{{ group.title }}</h3><p class="mt-2 text-sm leading-6 text-ink-500">{{ group.description }}</p></div><a href="{{ group.url }}" class="focus-ring shrink-0 rounded-lg bg-brand-50 px-3 py-2 text-xs font-semibold text-brand-600">阅读指南</a></div><div class="mt-5 flex flex-wrap gap-2">{% for keyword in group.keywords %}<span class="rounded-full border border-line bg-paper px-3 py-1.5 text-xs text-ink-600">{{ keyword }}</span>{% endfor %}</div></article>{% endfor %}</div></div></section>
{% endif %}
<section id="directory" class="section-space bg-white"><div class="container-shell"><div class="max-w-2xl"><span class="eyebrow">Directory</span><h2 class="mt-3 text-3xl font-bold tracking-[-0.035em] text-ink-950">栏目内容入口</h2><p class="mt-4 text-sm leading-7 text-ink-500">以下卡片用于承载后续子分类、索引页或重点文章，当前不包含真实推广信息。</p></div><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{% for entry in section.entries %}<a href="/blog/" class="focus-ring group rounded-3xl border border-line bg-white p-6 transition hover:-translate-y-1 hover:border-brand-100 hover:shadow-card"><div class="flex items-center justify-between"><span class="text-xs font-bold text-brand-600">0{{ loop.index }}</span>{{ icon('arrow-up-right', 16, 'text-ink-300 transition group-hover:text-brand-600') }}</div><h3 class="mt-8 text-lg font-bold text-ink-950">{{ entry }}</h3><p class="mt-2 text-sm leading-6 text-ink-500">预留说明、筛选条件、最近更新与相关内容入口。</p></a>{% endfor %}</div></div></section>
<section class="border-y border-line bg-paper py-16 lg:py-20"><div class="container-shell grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><span class="eyebrow">Overview</span><h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-950">关于本栏目</h2></div><div><p class="text-base leading-8 text-ink-700">{{ section.intro }}</p><div class="mt-8 grid gap-3 sm:grid-cols-3">{% for item in ['内容结构已预留','支持持续更新','内链路径清晰'] %}<div class="flex items-center gap-2 rounded-xl border border-line bg-white px-4 py-3 text-xs font-semibold text-ink-700">{{ icon('check', 15, 'text-brand-600') }}{{ item }}</div>{% endfor %}</div></div></div></section>
<section class="section-space bg-white"><div class="container-shell"><div class="mx-auto mb-10 max-w-2xl text-center"><span class="eyebrow">FAQ</span><h2 class="mt-3 text-3xl font-bold text-ink-950">常见问题</h2></div>{{ faq(sectionFaqs) }}</div></section>
<section class="container-shell pb-20 lg:pb-28"><div class="relative overflow-hidden rounded-[2rem] bg-ink-950 px-6 py-14 text-white sm:px-10 lg:px-16"><div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><h2 class="text-3xl font-bold">继续浏览相关内容</h2><p class="mt-4 text-sm leading-7 text-slate-300">从文章索引或专题页进入下一条阅读路径。</p></div><a href="/blog/" class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-ink-950">浏览文章 {{ icon('arrow', 16) }}</a></div></div></section>
